# Spring Boot runtime profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL
MOVIE_DB_URL=jdbc:mysql://127.0.0.1:3306/movie_data_analysis?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MOVIE_DB_USERNAME=movie_app
MOVIE_DB_PASSWORD=movie_app_dev

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# JWT
JWT_ISSUER=movie-data-analysis
JWT_SECRET=movie-data-analysis-dev-secret-change-me-32bytes
JWT_ACCESS_TOKEN_TTL=2h
JWT_REFRESH_TOKEN_TTL=7d

# TMDb
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_DEFAULT_LANGUAGE=zh-CN
TMDB_DEFAULT_REGION=CN

# Python ETL
PYTHON_ETL_BASE_URL=http://127.0.0.1:9000
PYTHON_ETL_CALLBACK_SECRET=

# Local file upload
FILE_UPLOAD_ROOT=.local/uploads
FILE_PUBLIC_URL_PREFIX=/api/v1/files
FILE_MAX_IMAGE_SIZE=5MB
FILE_MAX_REQUEST_SIZE=20MB
FILE_MAX_IMAGE_SIZE_BYTES=5242880
